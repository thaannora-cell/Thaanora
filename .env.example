# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored. Never commit real keys.
# Supabase dashboard → Project Settings → API (or "Connect" → App Frameworks → Next.js)

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Public key: the "anon" key (eyJ...) or the newer "publishable" key (sb_publishable_...).
# Safe in the browser: Row Level Security limits what it can read.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret key: the "service_role" key (eyJ...) or the newer "secret" key (sb_secret_...).
# SERVER ONLY. Bypasses Row Level Security. Never prefix with NEXT_PUBLIC_.
# Used locally by `npm run photos`, and later by server routes for orders and requests.
SUPABASE_SERVICE_ROLE_KEY=

# Pre-launch password for the whole site. Leave empty locally to browse without it.
# Set it in Vercel to keep the test deployment private. Remove it there on launch day.
SITE_PASSWORD=
